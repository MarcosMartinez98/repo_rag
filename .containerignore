# Git and CI — never needed inside the image
.git/
.github/

# Python cache — always regenerated at runtime
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Secrets — NEVER bake into an image
.env

# Virtual environments
.venv/
venv/

# Test suite — not needed in production
tests/

# Local ChromaDB data — always mounted as a volume in production
chroma_db/

# Dev tooling and docs
*.md
.pre-commit-config.yaml
.mypy_cache/
.ruff_cache/

# Coverage artifacts
coverage.xml
.coverage

# Compose and infrastructure scripts — not needed inside the container
compose.yaml
scripts/
infra/
